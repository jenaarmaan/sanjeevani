rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Role-Based Access Control
    function isSignedIn() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Triage Sessions
    match /triage_sessions/{sessionId} {
      // Patients can read/write their own sessions
      // Doctors/Admins can read all for clinical oversight
      allow create: if isSignedIn();
      allow read: if isOwner(resource.data.patientId) || hasRole('doctor') || hasRole('field-worker') || isAdmin();
      allow update: if isOwner(resource.data.patientId) || hasRole('doctor') || isAdmin();
    }

    // Health Records
    match /health_records/{recordId} {
      allow create: if isSignedIn();
      allow read: if isOwner(resource.data.patientId) || hasRole('doctor') || isAdmin();
      allow delete: if isOwner(resource.data.patientId) || isAdmin();
    }

    // Global Public Health Data (Aggregated)
    match /public_health_stats/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
